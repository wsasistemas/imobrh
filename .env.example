# Copie para .env.local e preencha. Nunca coloque a chave service_role (secreta) aqui.
# Sem URL e chave, o modelo roda no modo simulado (dados em memória e login de teste).
VITE_SUPABASE_URL=https://<projeto>.supabase.co
VITE_SUPABASE_ANON_KEY=<chave-publishable>
# Schema do aplicativo no Supabase compartilhado (o mesmo de `npm run novo-app -- <schema>`).
VITE_APP_SCHEMA=modelo
# supabase (padrão) ou mock (dados em memória com o login real, para demonstração e testes)
VITE_DATA_SOURCE=supabase
