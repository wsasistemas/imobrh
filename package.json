    "deno:check": "npx --yes deno check supabase/functions/*/index.ts"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.11.10",
    "embedded-postgres": "^17.5.0-beta.15",
    "oxlint": "^1.81.0",
    "pg": "^8.13.1",
    "typescript": "~6.0.2",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.12"
  }
}
