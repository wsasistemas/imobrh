# Copie para .env.local e preencha. Nunca coloque a chave service_role (secreta) aqui.
# Sem URL e chave, o Console roda no modo simulado (dados em memória e login de teste).
# Projeto: ikvj (ikvjaowvpvxojvcfwnct), o mesmo do imobdesk. O schema app_imobrh é fixo em src/config/app.ts.
VITE_SUPABASE_URL=https://ikvjaowvpvxojvcfwnct.supabase.co
VITE_SUPABASE_ANON_KEY=<chave-publishable>
# supabase (padrão) ou mock (dados em memória com o login real, para demonstração e testes)
VITE_DATA_SOURCE=supabase
